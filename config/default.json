    "context_after": 2.0,
    "fps": 4,
    "width": 64,
    "height": 36,
    "reaction_threshold": 0.35
  },
  "fusion": {
    "alpha": 0.6,
    "beta": 0.4,
    "decision_threshold": 0.55,
    "audio_override_threshold": 0.92,
    "reaction_override_threshold": 0.88
  },
  "label_taxonomy": {
    "sharp_impact": "[Impact sound]",
    "loud_sound": "[Loud sound]",
    "sustained_sound": "[Sustained sound]",
    "sound_event": "[Sound effect]"
